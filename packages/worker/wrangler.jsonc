{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "zumda-worker",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "observability": { "enabled": true },
    "vars": {
        "APP_ORIGIN": "http://localhost:5173",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "zumda",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "zumda-media" }],
    // Per-user limits for calls that cost D1 reads or ping admins (free tier counts rows read).
    "ratelimits": [
        {
            "name": "SEARCH_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 60 },
        },
        {
            "name": "SIGNUP_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 5, "period": 60 },
        },
    ],
}
