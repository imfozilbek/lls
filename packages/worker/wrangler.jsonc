{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "zumda-worker",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    // One request in five is logged: the alerts (src/alerts.ts) already bring every 5xx to the
    // admins, and the free plan's log quota is shared by every project of the account.
    "observability": { "enabled": true, "head_sampling_rate": 0.2 },
    // Production answers only at api.zumda.shop (the deploy adds it): no workers.dev or preview
    // address. Local `wrangler dev`, the tests and the e2e stand are not affected.
    "workers_dev": false,
    "preview_urls": false,
    // The Mini App's three addresses: customers (app.), businesses (business.), couriers
    // (delivery.). Locally all three are the one dev server; the deploy sets the real ones.
    "vars": {
        "APP_ORIGIN": "http://localhost:5173",
        "BUSINESS_APP_ORIGIN": "http://localhost:5173",
        "COURIER_APP_ORIGIN": "http://localhost:5173",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "zumda",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    // BUCKET: public files (photos, logos, posters, the map), also served from media. and map.
    // zumda.shop without the Worker. RECEIPTS: transfer screenshots, private, kept 30 days.
    "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "zumda-media" },
        { "binding": "RECEIPTS", "bucket_name": "zumda-receipts" },
    ],
    // Per-user limits for calls that cost D1 reads or ping admins (free tier counts rows read).
    "ratelimits": [
        {
            "name": "SEARCH_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 60 },
        },
        {
            "name": "SIGNUP_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 5, "period": 60 },
        },
        // Mini App crash reports, per address (they come before any sign-in).
        {
            "name": "CLIENT_ERROR_LIMITER",
            "namespace_id": "1003",
            "simple": { "limit": 10, "period": 60 },
        },
        // «Ro'yxat bilan qo'shish»: up to 50 products a list, a few lists a minute (D1 writes).
        {
            "name": "BULK_LIMITER",
            "namespace_id": "1004",
            "simple": { "limit": 5, "period": 60 },
        },
    ],
}
