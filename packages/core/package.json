{
    "name": "@zumda/core",
    "version": "0.4.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "tsc -p tsconfig.test.json && vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean": "rm -rf dist"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.0",
        "typescript": "^5.7.2",
        "vitest": "^4.1.0"
    }
}
