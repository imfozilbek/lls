{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": false
    },
    "include": ["stand", "support", "specs", "playwright.config.ts"]
}
