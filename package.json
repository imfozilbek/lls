{
    "name": "zumda",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.11",
    "engines": {
        "node": ">=22.0.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun run --filter @zumda/core build && bun run --filter '*' build",
        "dev": "bun run --filter '*' dev",
        "test": "bun run --filter '*' test",
        "lint": "eslint packages --ext .ts,.tsx",
        "lint:fix": "eslint packages --ext .ts,.tsx --fix",
        "format": "prettier --write \"packages/**/*.{ts,tsx,json}\"",
        "format:check": "prettier --check \"packages/**/*.{ts,tsx,json}\"",
        "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
        "check:secrets": "./scripts/check-secrets.sh --all",
        "check:dashes": "./scripts/check-dashes.sh --all",
        "stand": "bun run --cwd packages/e2e stand",
        "e2e": "bun run --cwd packages/e2e e2e",
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.4",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "eslint": "^9.17.0",
        "eslint-plugin-import": "^2.31.0",
        "prettier": "^3.9.9",
        "typescript": "^5.7.2"
    }
}
